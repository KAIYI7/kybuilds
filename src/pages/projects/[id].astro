---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, date, order, stack, repo, summary, cover, coverAlt } = project.data;
---

<Base title={`${title} — ${site.name}`} description={summary}>
  <div class="wrap project">
    <div class="project-head">
      <a class="back" href="/#projects">← All projects</a>
      <h1>{title}</h1>
      <p class="sub">{tagline} · {date}</p>
      <ul class="tags">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
      <a class="btn" href={repo}>View source on GitHub</a>
    </div>
    <div class="project-cover">
      <Cover title={title} order={order} cover={cover} coverAlt={coverAlt} />
    </div>
    <article class="prose">
      <Content />
    </article>
  </div>
</Base>
